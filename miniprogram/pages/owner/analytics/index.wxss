.page {
  min-height: 100vh;
  background: #fdf6ec;
}

.state {
  padding: 100rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.scroll {
  height: calc(100vh - 88rpx);
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.grid4 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #e8b86d;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card.warn {
  background: #fff5f0;
  border: 2rpx solid #f5d0c8;
}

.warn-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #8b4513;
}

.warn-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a66;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d2c1e;
  margin-bottom: 20rpx;
}

.sub-hint {
  font-size: 22rpx;
  color: #aaa;
  margin: -12rpx 0 16rpx;
}

.row-meta {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.empty {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
  padding: 24rpx 0;
}

.top-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f0e8;
}

.top-row:last-child {
  border-bottom: none;
}

.rank {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #c9986a;
}

.top-body {
  flex: 1;
}

.top-name {
  display: block;
  font-size: 28rpx;
  color: #3d2c1e;
}

.top-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.chart-scroll {
  width: 100%;
  white-space: nowrap;
}

.chart-bars {
  display: inline-flex;
  align-items: flex-end;
  gap: 8rpx;
  min-height: 200rpx;
  padding-bottom: 8rpx;
}

.bar-col {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
}

.bar-track {
  width: 28rpx;
  height: 160rpx;
  background: #f5f0e8;
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  min-height: 4rpx;
  border-radius: 8rpx 8rpx 0 0;
}

.bar-fill.orders {
  background: #e8b86d;
}

.bar-fill.amount {
  background: #c9986a;
}

.bar-fill.mood-rating {
  background: #f5b8b8;
}

.bar-fill.mood-count {
  background: #e8d4a8;
  opacity: 0.7;
}

.bar-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #bbb;
  transform: scale(0.9);
}

.bar-sub {
  font-size: 18rpx;
  color: #c9986a;
}

.pad {
  height: 48rpx;
}
