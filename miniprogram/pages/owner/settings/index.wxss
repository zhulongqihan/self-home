@import './common.wxss';

.hub-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fdf6ec;
  box-sizing: border-box;
}

.hub-scroll {
  flex: 1;
  height: 0;
}

.hub-content {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.hub-tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.hub-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.hub-icon {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.hub-body {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.hub-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d2c1e;
}

.hub-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.hub-arrow {
  font-size: 40rpx;
  color: #c9986a;
  font-weight: 300;
}
