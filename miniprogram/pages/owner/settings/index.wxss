.page {
  min-height: 100vh;
  background: #fdf6ec;
  box-sizing: border-box;
}

.content {
  padding: 32rpx;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2c1e;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  min-height: 120rpx;
  background: #f8f0e8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-line {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  background: #f8f0e8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3d2c1e;
  box-sizing: border-box;
}

.field-placeholder {
  color: #b0a090;
  font-size: 26rpx;
  line-height: 88rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #f8f0e8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3d2c1e;
  box-sizing: border-box;
}

.picker-placeholder {
  color: #b0a090;
}

.picker-arrow {
  font-size: 36rpx;
  color: #c9986a;
  line-height: 1;
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.section-head {
  margin: 40rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2c1e;
}

.save-btn {
  background: #e8b86d;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.save-btn-secondary {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.state-text {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.row-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.input-line.short {
  flex: 1;
}

.picker-val {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f8f0e8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3d2c1e;
}

.label-gap {
  margin-top: 16rpx;
}

.egg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5ebe0;
}

.egg-row:last-child {
  border-bottom: none;
}

.egg-label {
  font-size: 28rpx;
  color: #3d2c1e;
}

.switch-row {
  justify-content: space-between;
  padding: 8rpx 0;
}

.hint-box {
  background: #fffaf2;
  border: 1rpx solid #f0dcc0;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.btn-add-slot {
  margin-top: 12rpx;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f0e6da;
  color: #3d2c1e;
  font-size: 28rpx;
}

.slot-list {
  margin-top: 16rpx;
}

.slot-card {
  background: #f8f0e8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.slot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slot-range {
  font-size: 26rpx;
  font-weight: 600;
  color: #3d2c1e;
}

.slot-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.slot-del {
  margin-top: 8rpx;
  text-align: right;
  font-size: 24rpx;
  color: #c9986a;
}
