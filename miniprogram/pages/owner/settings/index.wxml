<view class="page hub-page">
  <page-header title="系统设置" showBack="{{true}}" backUrl="/pages/owner/index/index" />
  <scroll-view class="hub-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="hub-content">
      <view class="hub-tip">按模块进入，改完保存即可返回；不必在长页里来回滑。</view>
      <view
        class="hub-item"
        wx:for="{{menus}}"
        wx:key="key"
        data-url="{{item.url}}"
        bindtap="onOpenMenu"
      >
        <text class="hub-icon">{{item.icon}}</text>
        <view class="hub-body">
          <view class="hub-title">{{item.title}}</view>
          <view class="hub-desc">{{item.desc}}</view>
        </view>
        <text class="hub-arrow">›</text>
      </view>
    </view>
  </scroll-view>
</view>
