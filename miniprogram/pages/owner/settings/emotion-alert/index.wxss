@import '../common.wxss';

.state {
  padding: 80rpx;
  text-align: center;
  color: #999;
}

.scroll {
  height: calc(100vh - 88rpx);
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.tip {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2c1e;
  margin-bottom: 16rpx;
}

.input {
  background: #fdf6ec;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
}

.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.row-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.row-card .hint {
  margin-top: 8rpx;
}

.preview-msg {
  font-size: 28rpx;
  color: #c9986a;
  line-height: 1.5;
}

.save-btn {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #e8b86d, #c9986a);
  color: #fff;
  border-radius: 999rpx;
}

.save-btn::after {
  border: none;
}

.pad {
  height: 48rpx;
}
