<view class="sub-page">
  <page-header title="我们的小日子" showBack="{{true}}" backUrl="/pages/owner/settings/index" />
  <scroll-view class="sub-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="sub-content">
      <view wx:if="{{loading}}" class="state-text">加载中...</view>
      <block wx:else>
        <view class="lock-tip">{{lockNote}}</view>
        <view class="section">
          <view class="label">在一起起始日</view>
          <view class="readonly-field">{{relationshipStart}}</view>
        </view>
        <view class="section">
          <view class="label">纪念日（每年）</view>
          <view class="readonly-field">{{anniversaryDisplay}}</view>
        </view>
        <view class="section">
          <view class="label">{{customerNickname}}生日</view>
          <view class="readonly-field">{{customerBirthdayDisplay}}</view>
        </view>
        <view class="section">
          <view class="label">{{ownerNickname}}生日</view>
          <view class="readonly-field">{{ownerBirthdayDisplay}}</view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
