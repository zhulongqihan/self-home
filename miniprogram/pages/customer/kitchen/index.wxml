<view class="page">
  <page-header title="点单" />
  <view wx:if="{{timeEgg}}" class="time-egg-bar">
    <image wx:if="{{timeEgg.banner}}" class="time-egg-banner" src="{{timeEgg.banner}}" mode="aspectFill" />
    <view class="time-egg-body">
      <text class="time-egg-tag">⏰ {{timeEgg.start}}-{{timeEgg.end}}</text>
      <text class="time-egg-text">{{timeEgg.text}}</text>
    </view>
  </view>
  <view wx:if="{{weather}}" class="weather-bar">
    <view class="weather-icon">🌧️</view>
    <view class="weather-text">
      <text class="weather-tag">{{weather.cityName || '今日'}}{{weather.text}}{{weather.temp ? ' · ' + weather.temp + '°C' : ''}}</text>
      <text class="weather-banner">{{weather.banner}}</text>
    </view>
  </view>
  <view wx:if="{{festival}}" class="festival-bar" style="background: {{festival.themeColor}};">
    <image wx:if="{{festival.banner}}" class="festival-banner" src="{{festival.banner}}" mode="aspectFill" />
    <view class="festival-text">
      <text class="festival-tag">今日节日</text>
      <text class="festival-name">{{festival.name}}</text>
    </view>
  </view>
  <view wx:if="{{blindBox}}" class="blind-hint-bar">
    <view class="blind-hint-text">
      <text class="blind-hint-title">🎲 {{blindBox.title}}</text>
      <text class="blind-hint-sub">{{blindBox.hint}}</text>
      <text class="blind-hint-meta">今日剩余 {{blindBox.shakesLeft}} 次 · 从全店在售商品随机</text>
    </view>
  </view>
  <view class="search-row">
    <view class="search-placeholder">搜索</view>
  </view>

  <view class="main">
    <scroll-view class="side" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="side-item {{item.id === activeCategoryId ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSwitchCategory"
      >
        <text class="side-icon">{{item.icon || '🍵'}}</text>
        <text class="side-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view class="list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{loading}}" class="state">加载中...</view>
      <view wx:elif="{{loadError}}" class="state">加载失败，请切换 Tab 再回来</view>
      <view wx:elif="{{!categories.length}}" class="state">暂无可用分类，请联系店长配置</view>
      <block wx:else>
        <view wx:if="{{weatherProducts.length}}" class="weather-section">
          <view class="weather-section-title">☔ 热饮专场</view>
          <view
            wx:for="{{weatherProducts}}"
            wx:key="_id"
            class="product-row weather-product"
          >
            <image
              wx:if="{{item.coverUrl}}"
              class="thumb"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              data-id="{{item._id}}"
              binderror="onCoverError"
            />
            <view wx:else class="thumb thumb-emoji">{{item.coverEmoji}}</view>
            <view class="info">
              <view class="name">{{item.name}}</view>
              <view class="meta">{{item.metaText}}</view>
              <view class="price-row">
                <text class="price">¥{{item.price}}</text>
                <view
                  wx:if="{{item.hasSpecs}}"
                  class="btn-spec"
                  data-id="{{item._id}}"
                  bindtap="onTapSpec"
                >选规格</view>
                <view
                  wx:else
                  class="btn-add"
                  data-id="{{item._id}}"
                  bindtap="onTapAdd"
                >+</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{festivalProducts.length}}" class="festival-section">
          <view class="festival-section-title">🎉 {{festival.name}} · 专属菜单</view>
          <view
            wx:for="{{festivalProducts}}"
            wx:key="_id"
            class="product-row festival-product"
          >
            <image
              wx:if="{{item.coverUrl}}"
              class="thumb"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              data-id="{{item._id}}"
              binderror="onCoverError"
            />
            <view wx:else class="thumb thumb-emoji">{{item.coverEmoji}}</view>
            <view class="info">
              <view class="name">{{item.name}}</view>
              <view class="meta">{{item.metaText}}</view>
              <view class="price-row">
                <text class="price">¥{{item.price}}</text>
                <view
                  wx:if="{{item.hasSpecs}}"
                  class="btn-spec"
                  data-id="{{item._id}}"
                  bindtap="onTapSpec"
                >选规格</view>
                <view
                  wx:else
                  class="btn-add"
                  data-id="{{item._id}}"
                  bindtap="onTapAdd"
                >+</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{!products.length}}" class="state">这个分类还没有商品哦</view>
        <view
          wx:for="{{products}}"
          wx:key="_id"
          class="product-row"
        >
          <image
            wx:if="{{item.coverUrl}}"
            class="thumb"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            data-id="{{item._id}}"
            binderror="onCoverError"
          />
          <view wx:else class="thumb thumb-emoji">{{item.coverEmoji}}</view>
          <view class="info">
            <view class="name">{{item.name}}</view>
            <view class="meta">{{item.metaText}}</view>
            <view class="desc">{{item.description}}</view>
            <view class="price-row">
              <text class="price">¥{{item.price}}</text>
              <view
                wx:if="{{item.hasSpecs}}"
                class="btn-spec"
                data-id="{{item._id}}"
                bindtap="onTapSpec"
              >选规格</view>
              <view
                wx:else
                class="btn-add"
                data-id="{{item._id}}"
                bindtap="onTapAdd"
              >+</view>
            </view>
          </view>
        </view>
      </block>
      <view class="list-pad"></view>
    </scroll-view>
  </view>

  <view wx:if="{{bulletText}}" class="bullet-layer">
    <view class="bullet-card">
      <text class="bullet-label">小羊说</text>
      <text class="bullet-content">{{bulletText}}</text>
    </view>
  </view>

  <view
    wx:if="{{blindBox && blindBox.shakesLeft > 0 && blindBox.poolCount > 0}}"
    class="blind-float {{blindShaking ? 'shaking' : ''}}"
    bindtap="onTapBlindShake"
  >
    <text class="blind-float-emoji">🎲</text>
    <text class="blind-float-text">{{blindBox.buttonText}}</text>
  </view>

  <view wx:if="{{blindRevealVisible && blindRevealProduct}}" class="blind-mask" bindtap="onCloseBlindReveal">
    <view class="blind-modal" catchtap="">
      <view class="blind-modal-title">🎉 开盒成功</view>
      <view class="blind-modal-product">
        <image
          wx:if="{{blindRevealProduct.coverUrl}}"
          class="blind-modal-thumb"
          src="{{blindRevealProduct.coverUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="blind-modal-thumb blind-modal-emoji">{{blindRevealProduct.coverEmoji}}</view>
        <view class="blind-modal-name">{{blindRevealProduct.name}}</view>
        <view class="blind-modal-price" wx:if="{{blindRevealProduct.blind_free}}">
          <text class="blind-free-tag">🎁 今日盲盒免费</text>
          <text class="blind-origin-price" wx:if="{{blindRevealProduct.original_price}}">原价 {{blindRevealProduct.original_price}} 币</text>
        </view>
        <view class="blind-modal-price" wx:else>{{blindRevealProduct.price}} 币</view>
        <view class="blind-modal-desc">{{blindRevealProduct.description}}</view>
      </view>
      <view class="blind-modal-actions">
        <view class="blind-btn blind-btn-primary" bindtap="onBlindAddToCart">加入购物车</view>
        <view class="blind-btn blind-btn-ghost" bindtap="onCloseBlindReveal">稍后再说</view>
      </view>
    </view>
  </view>

  <cart-bar
    id="cartBar"
    count="{{cartCount}}"
    total="{{cartTotal}}"
    drawer-open="{{drawerOpen}}"
    bind:toggle="onToggleDrawer"
    bind:close="onDrawerClose"
    bind:updated="onCartUpdated"
    bind:ordersuccess="onOrderSuccess"
  />

  <spec-panel
    wx:if="{{specVisible && specProduct}}"
    show="{{true}}"
    product="{{specProduct}}"
    bind:close="onSpecClose"
    bind:added="onSpecAdded"
  />
</view>
