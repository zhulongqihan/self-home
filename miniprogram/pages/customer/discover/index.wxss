.page {
  min-height: 100vh;
  background: #fdf6ec;
  box-sizing: border-box;
}

.content {
  padding: 40rpx;
}

.state {
  padding: 100rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.placeholder-card .emoji {
  font-size: 80rpx;
}

.placeholder-card .title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #3d2c1e;
}

.placeholder-card .desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.timeline-scroll {
  height: calc(100vh - 88rpx);
}

.hero {
  padding: 32rpx 40rpx 16rpx;
  text-align: center;
}

.hero-emoji {
  font-size: 64rpx;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #3d2c1e;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c9986a;
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 60rpx 40rpx;
  font-size: 28rpx;
  color: #999;
}

.timeline {
  padding: 16rpx 32rpx 0 24rpx;
}

.tl-item {
  display: flex;
  margin-bottom: 8rpx;
}

.tl-axis {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e8b86d;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #e8b86d;
  margin-top: 28rpx;
}

.type-milestone .tl-dot {
  background: #f5a8a8;
  box-shadow: 0 0 0 2rpx #f5a8a8;
}

.type-badge .tl-dot {
  background: #c9b8e8;
  box-shadow: 0 0 0 2rpx #c9b8e8;
}

.type-emotion_day .tl-dot {
  background: #f5a8a8;
  box-shadow: 0 0 0 2rpx #f5a8a8;
}

.tl-line {
  flex: 1;
  width: 4rpx;
  background: #f0e0c8;
  margin: 4rpx 0 0;
  min-height: 40rpx;
}

.tl-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin: 8rpx 0 16rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 30, 0.06);
}

.tl-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tl-emoji {
  font-size: 32rpx;
}

.tl-status {
  font-size: 24rpx;
  color: #c9986a;
  font-weight: 600;
}

.tl-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

.tl-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3d2c1e;
  line-height: 1.4;
}

.tl-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.bottom-pad {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
