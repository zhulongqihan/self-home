.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fdf6ec;
  box-sizing: border-box;
}

.page-scroll {
  flex: 1;
  height: 0;
}

.content {
  padding: 40rpx;
  padding-bottom: calc(var(--tab-bar-total-h) + 48rpx);
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.avatar {
  font-size: 88rpx;
}

.nickname {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #3d2c1e;
}

.coins {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #c9986a;
}

.store {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.sign-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #e8b86d;
}

.countdown-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
}

.countdown-title {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2c1e;
  margin-bottom: 20rpx;
}

.countdown-list {
  display: flex;
  justify-content: space-around;
}

.countdown-item {
  flex: 1;
  text-align: center;
}

.countdown-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #e8b86d;
  line-height: 1.2;
}

.countdown-unit {
  font-size: 22rpx;
  color: #c9986a;
  margin-bottom: 8rpx;
}

.countdown-label {
  font-size: 24rpx;
  color: #999;
}

.countdown-empty {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

.loading-text {
  color: #bbb;
}

.actions {
  margin-top: 24rpx;
}

.btn-kiss,
.btn-sign {
  background: #e8b86d;
  color: #3d2c1e;
  text-align: center;
  padding: 26rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.btn-kiss.disabled,
.btn-sign.disabled {
  opacity: 0.5;
}

.kiss-meta {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.badge-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 20rpx 20rpx;
}

.badge-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.badge-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2c1e;
}

.badge-meta {
  font-size: 22rpx;
  color: #c9986a;
}

.badge-hint {
  font-size: 20rpx;
  color: #bbb;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.badge-loading,
.badge-empty {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 16rpx 0;
}

.badge-scroll {
  width: 100%;
}

.badge-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 4rpx 8rpx;
}

.badge-item {
  width: 188rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  background: #fdf6ec;
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}

.badge-item.locked {
  opacity: 0.55;
}

.badge-item.unlocked {
  background: #fff8eb;
  border: 2rpx solid #f0d9a8;
}

.badge-emoji {
  font-size: 40rpx;
  line-height: 1.1;
}

.badge-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #3d2c1e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 54rpx;
}

.badge-progress {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #e8b86d;
}

.logout-wrap {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(201, 152, 106, 0.25);
}

.logout {
  text-align: center;
  color: #c9986a;
  font-size: 28rpx;
  padding: 20rpx 24rpx 8rpx;
}
